# ─────────────────────────────────────────────────────────────────────────────
# Smart Booking — variables de entorno
# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env` al repositorio.
# Ninguna de estas variables llega al navegador (no hay variables NEXT_PUBLIC_*).
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos PostgreSQL (14+). En producción usa SSL: ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/smartbooking"
# Solo para tests de integración (base de datos separada; se vacía en cada ejecución)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/smartbooking_test"

# URL pública de la app (sin barra final). Se usa para redirects OAuth y Stripe.
APP_URL="https://agenda.tudominio.com"

# 32 bytes aleatorios en base64 — cifra los tokens OAuth en reposo (AES-256-GCM).
# Generar: openssl rand -base64 32      (si la cambias, deberás reconectar Google/Microsoft)
ENCRYPTION_KEY=""
# Secreto ≥32 caracteres para firmas HMAC (state OAuth, huellas de IP).
# Generar: openssl rand -base64 48
AUTH_SECRET=""
# Token de un solo uso para crear la primera cuenta admin en /admin/setup.
# Generar: openssl rand -hex 24     (puedes eliminarlo después del onboarding)
SETUP_TOKEN=""
# Protege /api/cron/maintenance (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# ── Google Calendar (OAuth 2.0) — ver docs/CREDENTIALS.md#google ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Microsoft Graph (OAuth 2.0) — ver docs/CREDENTIALS.md#microsoft ──
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" (cuentas personales y de trabajo), "consumers", "organizations" o el ID de tu tenant
MICROSOFT_TENANT_ID="common"

# ── Stripe — ver docs/CREDENTIALS.md#stripe ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Operación ──
# true si la app está detrás de un proxy/CDN que fija X-Forwarded-For (Vercel, Render, Nginx…)
TRUST_PROXY="true"
LOG_LEVEL="info"
# SOLO desarrollo local: calendarios simulados sin credenciales. Prohibido en producción.
DEV_FAKE_CALENDARS="false"
