  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@remotion/bundler": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/effects": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "@remotion/media": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "@remotion/transitions": "4.0.542",
    "@remotion/zod-types": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "tsx": "^4.23.15",
    "zod": "^3.22.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio:new": "tsx scripts/new-project.ts",
    "studio:analyze": "tsx scripts/analyze.ts",
    "studio:broll": "tsx scripts/broll.ts",
    "studio:canvas": "tsx scripts/canvas.ts",
    "studio:render": "tsx scripts/render.ts",
    "studio:qc": "tsx scripts/qc.ts",
    "studio:showcase": "remotion render LibraryShowcase previews/_library/library-showcase.mp4 --scale=0.5",
