  "story": {
    "problem": "Muchas empresas recopilan datos de clientes, trabajadores o proveedores sin saber que eso puede constituir un banco de datos personales.",
    "whyItMatters": "Tener un banco de datos personales implica obligaciones legales bajo la Ley N.º 29733 y su reglamento.",
    "riskOrOpportunity": "No inscribirlo ni gestionarlo correctamente expone a la empresa a contingencias.",
    "openQuestion": "¿Tu empresa ya identificó y registró su banco de datos personales?",
    "payoff": "Inscribirlo en el Registro Nacional y revisar cómo obtienes, usas, conservas y proteges los datos.",
    "cta": "Revoredo Abogados protege tu negocio · Tenemos una conversación pendiente."
  },
