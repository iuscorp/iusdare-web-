  },
  {
   "start": 26.86,
   "end": 30.48,
   "text": "Nos vemos este 26 de noviembre, ocho a noche, en el live que es..."
  },
  {
   "start": 30.0,
   "end": 32.42,
   "text": "Nos esperamos."
  }
