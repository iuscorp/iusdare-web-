   "text": "Ping Pong Kong Miguel Eduardo Ramos Mirabal"
  },
  {
   "start": 2.78,
   "end": 3.48,
   "text": "¿A qué se dedica?"
  },
  {
   "start": 3.62,
   "end": 5.28,
   "text": "Abogado y docente universitario"
  },
  {
