      "role": "hook",
      "framing": "subtleIn",
      "move": "settle",
      "note": "¿Tu colegio te obliga a vender entradas para la Kermés?"
    },
    {
      "id": "s02",
      "in": 2.233,
      "out": 4.067,
      "role": "reveal",
      "framing": "punchIn",
      "move": "none",
      "note": "Eso es ilegal, la educación es un derecho,"
    },
    {
      "id": "s03",
      "in": 4.067,
      "out": 6.567,
      "role": "context",
      "framing": "base",
      "move": "none",
      "note": "no un negocio. Y vender entradas para la Kermés es"
    },
    {
      "id": "s04",
      "in": 6.567,
      "out": 9.533,
      "role": "context",
      "framing": "subtleIn",
      "move": "none",
      "note": "una colaboración. Y si te quieres bajar la nota de conducta"
    },
    {
      "id": "s05",
      "in": 9.533,
      "out": 11.333,
      "role": "context",
      "framing": "base",
      "move": "none",
      "note": "por no venderlas, no tienes sustento."
    },
    {
      "id": "s06",
      "in": 11.333,
      "out": 13.667,
      "role": "context",
      "framing": "subtleIn",
      "move": "none",
      "note": "En conducta se mide la disciplina y convivencia,"
    },
    {
      "id": "s07",
      "in": 13.667,
      "out": 16.367,
      "role": "context",
      "framing": "base",
      "move": "none",
      "note": "no las ventas. Y si te sacan de clase o no te dejan rendir"
    },
    {
      "id": "s08",
      "in": 16.367,
      "out": 18.833,
      "role": "context",
      "framing": "subtleIn",
      "move": "none",
      "note": "algún examen, eso vulnera tu derecho a la educación."
    },
    {
      "id": "s09",
      "in": 18.967,
      "out": 21.533,
      "role": "context",
      "framing": "base",
      "move": "none",
      "note": "Y sí, pueden existir concursos entre salones y personas"
    },
    {
      "id": "s10",
      "in": 21.533,
      "out": 23.3,
      "role": "context",
      "framing": "subtleIn",
      "move": "none",
      "note": "que vendan las entradas por voluntad,"
    },
    {
      "id": "s11",
      "in": 23.3,
      "out": 24.8,
      "role": "twist",
      "framing": "punchIn",
      "move": "none",
      "note": "pero es eso. Es voluntario."
    },
    {
      "id": "s12",
      "in": 24.8,
      "out": 27.333,
      "role": "recap",
      "framing": "subtleIn",
      "move": "none",
      "note": "Sin presiones ni castigos, en caso no deseas participar."
    },
    {
      "id": "s13",
      "in": 27.333,
      "out": 29.367,
      "role": "cta",
      "framing": "base",
      "move": "none",
      "note": "así que sigue a Vocare Iuris y guarda este video."
    },
    {
      "id": "s14",
      "in": 29.367,
      "out": 31.167,
      "role": "cta",
      "framing": "base",
      "move": "none",
      "note": "No sabes cuándo puede necesitarlo."
