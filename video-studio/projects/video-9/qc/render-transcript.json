{
 "model": "small",
 "language": "es",
 "duration": 33.259,
 "text": "Pin. Pong. Con. Martín Ruyero. ¿A qué se dedica? Soy abogado laboralista. ¿En qué le hubiera gustado especializarse si no hubiera sido laboral? Creo que en derecho civil, procesal civil, litigio. ¿Cuál es el error más común al contratar a una persona? Que debiendo contratarlo como trabajador en planilla no lo hacen. ¿Cuál cree que es el beneficio laboral que tendrá más complicaciones en las empresas? Hoy en día te diría que el cálculo y pago de vacaciones. ¿Cuál es el error más común sobre los beneficios sociales? Eso lo veremos en el live. Nos vemos este 1º de diciembre a las 8 p.m. en el live que tendremos con nuestros amigos de Vocare Iuris. Conversaré. Conversaremos sobre cálculo y pago de beneficios laborales. Nos esperamos.",
 "segments": [
  {
   "start": 0.0,
   "end": 0.12,
   "text": "Pin."
  },
  {
   "start": 0.26,
   "end": 0.54,
   "text": "Pong."
  },
  {
   "start": 0.68,
   "end": 0.76,
   "text": "Con."
  },
  {
   "start": 0.94,
   "end": 1.52,
   "text": "Martín Ruyero."
  },
  {
   "start": 1.62,
   "end": 2.26,
   "text": "¿A qué se dedica?"
  },
  {
   "start": 2.42,
   "end": 3.38,
   "text": "Soy abogado laboralista."
  },
  {
   "start": 3.44,
   "end": 5.88,
   "text": "¿En qué le hubiera gustado especializarse si no hubiera sido laboral?"
  },
  {
   "start": 5.92,
   "end": 8.4,
   "text": "Creo que en derecho civil, procesal civil, litigio."
  },
  {
   "start": 8.48,
   "end": 10.36,
   "text": "¿Cuál es el error más común al contratar a una persona?"
  },
  {
   "start": 10.0,
   "end": 14.02,
   "text": "Que debiendo contratarlo como trabajador en planilla no lo hacen."
  },
  {
   "start": 14.12,
   "end": 17.34,
   "text": "¿Cuál cree que es el beneficio laboral que tendrá más complicaciones en las empresas?"
  },
  {
   "start": 17.48,
   "end": 20.08,
   "text": "Hoy en día te diría que el cálculo y pago de vacaciones."
  },
  {
   "start": 20.0,
   "end": 23.4,
   "text": "¿Cuál es el error más común sobre los beneficios sociales?"
  },
  {
   "start": 23.44,
   "end": 24.44,
   "text": "Eso lo veremos en el live."
  },
  {
   "start": 24.64,
   "end": 29.2,
   "text": "Nos vemos este 1º de diciembre a las 8 p.m. en el live que tendremos con nuestros amigos"
  },
  {
   "start": 29.2,
   "end": 29.94,
   "text": "de Vocare Iuris."
  },
  {
   "start": 30.08,
   "end": 30.48,
   "text": "Conversaré."
  },
  {
   "start": 30.0,
   "end": 32.58,
   "text": "Conversaremos sobre cálculo y pago de beneficios laborales."
  },
  {
   "start": 32.68,
   "end": 33.12,
   "text": "Nos esperamos."
  }
 ],
